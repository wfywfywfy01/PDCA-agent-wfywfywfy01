# Incremental production delivery: reuse the reviewed runtime already on the host.
# Dependency/runtime changes must first rebuild Dockerfile and update this digest.
ARG NODE_RUNTIME_IMAGE=node:22-bookworm-slim
ARG SOURCE_REVISION=unknown

FROM ${NODE_RUNTIME_IMAGE} AS web-build
ARG SOURCE_REVISION
WORKDIR /web
RUN printf '%s\n' "$SOURCE_REVISION" > /tmp/pdca-source-revision
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY apps/web ./
RUN npm test && npm run typecheck && npm run build

FROM ghcr.io/wfywfywfy01/pdca-workbench@sha256:be0de3310a9460187415ddc31c3a47bed919c354fde404a2fa2ab2d72e79a5d8
ARG SOURCE_REVISION
LABEL com.vertu.pdca.source_revision=$SOURCE_REVISION \
      org.opencontainers.image.revision=$SOURCE_REVISION
ENV PDCA_RELEASE_SHA=$SOURCE_REVISION
WORKDIR /app

COPY pdca-workbench/requirements.txt pdca-workbench/requirements.lock ./
RUN python -m pip install --no-index --no-deps -r requirements.lock \
    && python -m pip check

# Remove deleted/renamed source files too. Never touch /app/data, /repo or /mvp.
RUN rm -rf /app/app /app/frontend /app/migrations /app/scripts /app/logibot /app/spa-dist
COPY pdca-workbench/app ./app
COPY pdca-workbench/frontend ./frontend
COPY pdca-workbench/migrations ./migrations
COPY pdca-workbench/scripts ./scripts
COPY pdca-workbench/run.py .
COPY pdca-workbench/logibot ./logibot
COPY --from=web-build /web/dist ./spa-dist

# CMD, health check, exposed port, runtime ENV and persistent volumes are inherited.
