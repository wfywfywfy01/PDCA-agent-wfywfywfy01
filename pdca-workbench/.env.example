# PDCA 工作台生产环境配置

# 服务
PDCA_ENV=production
TZ=Asia/Shanghai
PDCA_WORKBENCH_PORT=8767
PDCA_HOST_PORT=8768
PDCA_HOST=0.0.0.0
PDCA_SECRET_KEY=

# PostgreSQL（必填，由你方建库后填入）
# 格式：postgresql+psycopg2://用户名:密码@主机:端口/数据库名
PDCA_DATABASE_URL=postgresql+psycopg2://pdca:your_password@localhost:5432/pdca

# 仅首次建库时可临时设置；创建后立即从 .env 删除
# PDCA_BOOTSTRAP_ADMIN_USERNAME=admin
# PDCA_BOOTSTRAP_ADMIN_PASSWORD=请使用至少12位随机密码
# PDCA_BOOTSTRAP_ADMIN_DISPLAY_NAME=系统管理员
# 仅当确认当前库只有旧测试门店数据时才设为 1；应用启动会清除旧门店及五件套记录
# PDCA_CLEAN_LEGACY_STORE_DATA=0


# 业务数据路径
PDCA_MVP_ROOT=D:/经销商PDCA/data_platform/data_role_pdca_mvp
PDCA_REPO_ROOT=D:/经销商PDCA
# 旧版本地开发功能所需路径（Windows 示例，按实际机器调整）
# PDCA_CUSTOMER_MGMT_ROOT=C:\path\to\customer-mgmt
# PDCA_VN_XLSX=C:\path\to\越南门店数据.xlsx
# PDCA_COLLECT_XLSX=C:\path\to\Data collecet(5).xlsx
# HERMES_COMMAND=C:\path\to\hermes.exe


# vertu-cli 2.x
VERTU_COMMAND=vertu-cli
VERTU_VPS_SERVICE_URL=https://vps-service.vertu.cn
VERTU_APP_ID=cursor
# 使用 `vertu-cli agent env --app-id cursor --shell powershell` 读取；仅放在服务器密钥环境或未跟踪的 .env。
VERTU_APP_KEY=
VERTU_USER_LOGIN=
# Optional: production can use this Bot Key or a persisted `vertu login` user session.
VERTU_BOT_INBOUND_KEY=
VERTU_LEGACY_COMMAND=vertu
PDCA_REQUIRE_VERTU=1
PDCA_INCLUDE_DEMO_DATA=0
PDCA_MAX_REPORTED_REVENUE_USD=5000000
PDCA_REVENUE_REVIEW_THRESHOLD_USD=1000000

# 定时任务
PDCA_SCHEDULER_ENABLED=1
PDCA_SYNC_CRON=0 6 * * *
PDCA_LOG_LEVEL=INFO

# 待办催办（提醒跟进）：VPS IM 私聊直接催本人
# 每天在指定时刻自动催「今日 + 逾期」未完成待办；同一轮当天不重复
PDCA_TODO_REMIND_ENABLED=1
PDCA_TODO_REMIND_TIMES=09:30,16:30
# 催办消息里的处理入口链接
PDCA_WORKBENCH_URL=https://pdca-workbench-teams.vertu.cn/app/

# Vemory 会议待办（事实源：Vemory OpenAPI getUserMeetingTodos → pdca_tasks）
# 密钥走 VEMORY_OPENAPI_KEY（部署脚本自动进密钥通道；未配置则同步安全跳过）
# 名单为 JSON 数组：[{"name":"姓名","vemoryUserId":41,"vpsUserId":13063}, ...]
# PDCA_VEMORY_TODO_USERS=[{"name":"于冰","vemoryUserId":41,"vpsUserId":13063}]
# 默认走正式环境 https://vemory-meet.vemory.io；测试环境为 https://t-vemory-meet.vertu.cn（内网）
# PDCA_VEMORY_OPENAPI_URL=https://vemory-meet.vemory.io
# Vemory 无截止待办的宽限期（小时）：会议满此时长后才催办，默认 48
# PDCA_TODO_REMIND_GRACE_HOURS=48

# 运维告警（F7）：同步/备份/健康检查失败时向 webhook 推送
# 留空则只写 [alert] 日志；Slack/企微/钉钉自定义机器人兼容 {"text": ...} 格式
# PDCA_ALERT_WEBHOOK_URL=https://your-webhook.example/path

# HTTPS（NGINX 负责 SSL 终止时设 1，Cookie 会携带 Secure 标志）
# 对外上线必须设为 1，否则浏览器拒绝 httpOnly Cookie
PDCA_SECURE_COOKIES=1
PDCA_SSL_CERT=./certs/cert.pem
PDCA_SSL_KEY=./certs/key.pem

# 认证模式：对外经销商必须用 local（不依赖内网 vertu 命令）
# local=本地账号 | vps=仅 vertu/Odoo 登录 | hybrid=本地 JWT + VPS 均可
PDCA_AUTH_MODE=hybrid
# VPS 未登录时登录页跳转链接（auth_mode=vps 时使用）
PDCA_VPS_LOGIN_URL=https://vps.vertu.cn
# 信任 Nginx/SSO 注入的 X-VPS-User-Login 等 Header（多用户生产设 1）
PDCA_TRUST_PROXY_HEADERS=0
# 开启代理身份头时必填：逗号分隔的可信反向代理 IP；未配置时代码 fail closed
# PDCA_TRUSTED_PROXY_IPS=10.0.0.1
# 仅当 SSO 代理会安全生成 X-VPS-User-Role 时开启（默认不信任该头）
# PDCA_TRUST_PROXY_ROLE_HEADER=1
# 生产 PostgreSQL 不可用时是否允许回退本地 SQLite；默认禁止，防止数据分叉
# PDCA_ALLOW_SQLITE_FALLBACK=1

# 每次 VPS 同步是否覆盖本地 role（默认 0，保留手工调权）
PDCA_VPS_SYNC_ROLE=0
# CORS 白名单，逗号分隔；留空则不发送跨域头（同源前端不受影响）
# PDCA_CORS_ORIGINS=https://pdca-workbench-teams.vertu.cn
# 允许把本站嵌进 iframe 的来源（CSP frame-ancestors）。未设默认 admin.vertu.cn；设空则只允许同源。
# PDCA_FRAME_ANCESTORS=https://admin.vertu.cn
# Odoo iframe 免登共享密钥，需与 Odoo 系统参数 pdca.sso_secret 一致
# PDCA_ODOO_SSO_SECRET=
# Odoo 站点，用来校验 iframe 里带过来的 session_id（只信这一份，不信 URL 里的 user_id）
# PDCA_ODOO_BASE_URL=https://admin.vertu.cn

# PostgreSQL 备份（pg_dump 用，可选；未设则从 PDCA_DATABASE_URL 解析）
# PDCA_PG_HOST=localhost
# PDCA_PG_PORT=5432
# PDCA_PG_USER=pdca
# PDCA_PG_PASSWORD=your_password
# PDCA_PG_DATABASE=pdca
# 可选：指定与服务器版本兼容的 pg_dump
# PDCA_PG_DUMP_COMMAND=/usr/lib/postgresql/18/bin/pg_dump
